# ---------------------------------------------------------------------------
# AgriPulse (Laravel) — environment configuration.
# Copy this file to `.env` (in the `backend/` folder) and adjust as needed.
# This file contains NO secrets. Never commit a real `.env`.
# ---------------------------------------------------------------------------

APP_NAME=AgriPulse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Logging channel (single, daily, stack, ...)
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — SQLite
# ---------------------------------------------------------------------------
# The SQLite file lives in the top-level `database/` folder. Leave DB_DATABASE
# unset — config/database.php defaults it to ../database/database.sqlite.
DB_CONNECTION=sqlite
# DB_DATABASE=
# Leave the remaining DB_* keys empty — they are not used by SQLite.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions / authentication
# ---------------------------------------------------------------------------
# Token lifetime in hours (default 168 = 7 days), matching the original system.
SESSION_TTL_HOURS=168
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ---------------------------------------------------------------------------
# Open-Meteo weather (public, no API key required)
# ---------------------------------------------------------------------------
OPEN_METEO_BASE=https://api.open-meteo.com/v1

# ---------------------------------------------------------------------------
# Commodity market data (optional future authenticated endpoint)
# ---------------------------------------------------------------------------
MARKET_DATA_API_KEY=
MARKET_DATA_API_URL=
